extends layout

block content
  h2 All Countries

  p Total countries: #{countries.length}

  table(border="1")
    thead
      tr
        th Country
        th Capital
        th Currency Name
        th Currency Symbol
    tbody
      each country in countries
        tr
          td= country.names.common
          td
            if country.capitals && country.capitals.length > 0
              each capital, index in country.capitals
                if index > 0
                  | ,
                = capital.name
            else
              | Not available
          td
            if country.currencies && country.currencies.length > 0
              each currency, index in country.currencies
                if index > 0
                  | ,
                = currency.name
            else
              | Not available
          td
            if country.currencies && country.currencies.length > 0
              each currency, index in country.currencies
                if index > 0
                  | ,
                = currency.symbol || 'Not available'
            else
              | Not available